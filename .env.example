# --- Email delivery ---------------------------------------------------------
# The app picks a provider in this order: Gmail SMTP -> Brevo -> Resend.
# Gmail SMTP (free, sends to anyone). Create an App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# GMAIL_USER is your full address; GMAIL_APP_PASSWORD is the 16-char app password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# Optional fallbacks:
BREVO_API_KEY=
RESEND_API_KEY=re_your_api_key
# Use onboarding@resend.dev while testing, then replace it with a sender on your verified domain.
CONTACT_FROM_EMAIL=Muhammad Musa Portfolio <onboarding@resend.dev>
# Set this to the final public origin, without a trailing slash, before deployment.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
KV_REST_API_URL=
KV_REST_API_TOKEN=
NEWSLETTER_FROM_EMAIL=Muhammad Musa Newsletter <onboarding@resend.dev>
NEWSLETTER_PUBLIC_URL=https://your-domain.com
# Used only by the server-side daily delivery endpoint.
CRON_SECRET=replace_with_a_long_random_value
# Signs one-click unsubscribe links. Keep server-side and use a different long value in production.
NEWSLETTER_UNSUBSCRIBE_SECRET=replace_with_a_different_long_random_value
